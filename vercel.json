{
  "version": 2,
  "builds": [
    {
      "src": "build.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "." }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/estimate.html" },
    { "src": "/estimate", "dest": "/estimate.html" },
    { "src": "/estimate.html", "dest": "/estimate.html" },
    { "src": "/quote", "dest": "/jilly_form.html" },
    { "src": "/pro-center", "dest": "/pro-center.html" },
    { "src": "/pro-center.html", "dest": "/pro-center.html" },
    { "src": "/photos", "dest": "/photos.html" },
    { "src": "/photos.html", "dest": "/photos.html" },
    { "src": "/img/([a-z0-9-]+\\.webp)", "dest": "/img/$1", "headers": { "cache-control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
